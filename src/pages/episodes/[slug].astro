---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Player from '../../components/Player.astro';
import { getEpisodes } from '../../lib/episodes';
import { formatDate, formatDuration } from '../../lib/format';

export async function getStaticPaths() {
  const episodes = await getEpisodes();
  // Sorted newest first, so "newer" is the previous item and "older" the next.
  return episodes.map((episode, i) => ({
    params: { slug: episode.id },
    props: { episode, newer: episodes[i - 1], older: episodes[i + 1] },
  }));
}

const { episode, newer, older } = Astro.props;
const { number, title, pubDate, durationSeconds, summary, audioUrl, audioType, authors, keywords, transcriptUrl } = episode.data;
const { Content } = await render(episode);
const base = import.meta.env.BASE_URL;
---
<Base title={title} description={summary} type="article">
  <article class="container episode">
    <a class="back" href={`${base}episodes/`}>&larr; All episodes</a>
    <header>
      <p class="meta">
        {number !== null && <span class="number">Episode {number}</span>}
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {durationSeconds && <span>{formatDuration(durationSeconds)}</span>}
      </p>
      <h1>{title}</h1>
      {authors && <p class="authors">With {authors}</p>}
    </header>

    <Player src={audioUrl} type={audioType} title={title} />

    <div class="links">
      <a href={audioUrl} download>Download MP3</a>
      {transcriptUrl && <a href={transcriptUrl}>Transcript</a>}
    </div>

    <div class="prose show-notes">
      <Content />
    </div>

    {keywords.length > 0 && (
      <ul class="tags" aria-label="Topics">
        {keywords.map((k) => <li>{k}</li>)}
      </ul>
    )}

    <nav class="pager" aria-label="More episodes">
      {older ? (
        <a class="older" href={`${base}episodes/${older.id}/`}>
          <span>Previous episode</span>{older.data.title}
        </a>
      ) : <span />}
      {newer && (
        <a class="newer" href={`${base}episodes/${newer.id}/`}>
          <span>Next episode</span>{newer.data.title}
        </a>
      )}
    </nav>
  </article>
</Base>

<style>
  .episode { max-width: 52rem; padding-block: 2rem; }
  .back { display: inline-block; margin-bottom: 2rem; font-weight: 600; text-decoration: none; font-size: 0.9rem; }
  .meta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 0; color: var(--color-ink-muted); font-size: 0.9rem; }
  .number { color: var(--color-link); font-weight: 600; }
  h1 { margin: 0.5rem 0 0.75rem; font-size: clamp(1.75rem, 4.5vw, 2.6rem); }
  .authors { color: var(--color-ink-muted); margin: 0 0 2rem; }
  .links { display: flex; gap: 1.5rem; margin: 1rem 0 2.5rem; font-size: 0.9rem; font-weight: 600; }
  .links a { text-decoration: none; }
  .show-notes { font-size: 1.05rem; }
  .tags { list-style: none; padding: 0; margin: 2.5rem 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .tags li {
    font-size: 0.8rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: var(--color-tag-bg);
    color: var(--color-ink);
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
  .pager a {
    display: flex; flex-direction: column; gap: 0.25rem;
    padding: 1rem 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-ink);
    text-decoration: none;
    font-weight: 600;
  }
  .pager a:hover { border-color: var(--color-primary); }
  .pager span { font-size: 0.8rem; font-weight: 300; color: var(--color-ink-muted); }
  .newer { text-align: right; grid-column: 2; }
  @media (max-width: 600px) {
    .pager { grid-template-columns: 1fr; }
    .newer { grid-column: auto; text-align: left; }
  }
</style>
