---
import Base from '../layouts/Base.astro';
import EpisodeCard from '../components/EpisodeCard.astro';
import { getEpisodes } from '../lib/episodes';
import { SITE_TITLE, SITE_TAGLINE } from '../site';

const latest = (await getEpisodes()).slice(0, 6);
const base = import.meta.env.BASE_URL;
---
<Base>
  <section class="hero">
    <h1>{SITE_TITLE}</h1>
    <p class="tagline">{SITE_TAGLINE}</p>
  </section>

  <section>
    <h2>Latest episodes</h2>
    <div class="grid">
      {latest.map((episode) => <EpisodeCard episode={episode} />)}
    </div>
    <p><a href={`${base}episodes/`}>All episodes &rarr;</a></p>
  </section>
</Base>

<style>
  .hero { padding-block: 3rem 2rem; }
  .hero h1 { font-family: var(--font-display); font-size: clamp(2rem, 5vw, 3rem); margin: 0; }
  .tagline { font-size: 1.2rem; color: var(--color-ink-muted); }
  .grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }
</style>
