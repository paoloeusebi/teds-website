---
import Base from '../layouts/Base.astro';
import EpisodeCard from '../components/EpisodeCard.astro';
import FollowLinks from '../components/FollowLinks.astro';
import Player from '../components/Player.astro';
import { getEpisodes } from '../lib/episodes';
import { formatDate, formatDuration } from '../lib/format';
import HostNames from '../components/HostNames.astro';
import { SITE_TAGLINE, SITE_DESCRIPTION } from '../site';

const episodes = await getEpisodes();
const [latest, ...rest] = episodes;
const recent = rest.slice(0, 6);
const base = import.meta.env.BASE_URL;
---
<Base>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="eyebrow">The podcast</p>
        <h1>{SITE_TAGLINE}</h1>
        <p class="lede">{SITE_DESCRIPTION}</p>
        <p class="hosts">With <HostNames /></p>
        <div class="actions">
          {latest && <a class="button primary" href={`${base}episodes/${latest.id}/`}>Listen to the latest episode</a>}
          <a class="button secondary" href={`${base}episodes/`}>Browse all {episodes.length} episodes</a>
        </div>
      </div>
      <img class="hero-icon" src={`${base}brand/icon.png`} alt="" width="256" height="431" />
    </div>
  </section>

  {latest && (
    <section class="container latest" aria-labelledby="latest-heading">
      <p class="eyebrow">Latest episode</p>
      <div class="latest-card">
        <p class="meta">
          {latest.data.number !== null && <span class="number">Episode {latest.data.number}</span>}
          <time datetime={latest.data.pubDate.toISOString()}>{formatDate(latest.data.pubDate)}</time>
          {latest.data.durationSeconds && <span>{formatDuration(latest.data.durationSeconds)}</span>}
        </p>
        <h2 id="latest-heading"><a href={`${base}episodes/${latest.id}/`}>{latest.data.title}</a></h2>
        {latest.data.summary && <p class="summary">{latest.data.summary}</p>}
        <Player src={latest.data.audioUrl} type={latest.data.audioType} title={latest.data.title} />
      </div>
    </section>
  )}

  <section class="container recent" aria-labelledby="recent-heading">
    <div class="section-head">
      <h2 id="recent-heading">Recent episodes</h2>
      <a href={`${base}episodes/`}>All episodes &rarr;</a>
    </div>
    <div class="grid">
      {recent.map((episode) => <EpisodeCard episode={episode} />)}
    </div>
  </section>

  <section id="follow" class="container follow" aria-labelledby="follow-heading">
    <h2 id="follow-heading">Follow for free</h2>
    <p>Never miss an episode. Subscribe in your favourite podcast app.</p>
    <FollowLinks />
  </section>
</Base>

<style>
  .hero {
    background: linear-gradient(180deg, var(--color-surface), var(--color-bg));
    border-bottom: 1px solid var(--color-border);
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 3rem;
    padding-block: clamp(3rem, 8vw, 5.5rem);
  }
  .hero h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 5vw, 3.25rem);
    margin: 0.5rem 0 1rem;
    max-width: 18ch;
  }
  .lede { font-size: clamp(1.05rem, 2vw, 1.25rem); margin: 0; max-width: 46ch; }
  .hosts { color: var(--color-ink-muted); margin: 0.75rem 0 0; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .hero-icon { height: clamp(180px, 22vw, 280px); width: auto; }
  @media (max-width: 720px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-icon { display: none; }
  }

  .latest { margin-top: 3.5rem; }
  .latest-card {
    margin-top: 0.75rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--color-band);
    color: var(--color-on-band);
    border-radius: calc(var(--radius) * 1.5);
  }
  .latest-card .meta {
    display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 0;
    font-size: 0.85rem; color: var(--color-on-band-muted);
  }
  .latest-card .number { color: var(--color-primary-bright); font-weight: 600; }
  .latest-card h2 { font-size: clamp(1.4rem, 3vw, 2rem); margin: 0.5rem 0 0.75rem; max-width: 30ch; }
  .latest-card h2 a { color: inherit; text-decoration: none; }
  .latest-card h2 a:hover { color: var(--color-primary-bright); }
  .latest-card .summary { margin: 0 0 1.5rem; max-width: var(--measure); color: var(--color-on-band-muted); }

  .recent { margin-top: 4rem; }
  .section-head {
    display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;
  }
  .section-head h2 { margin: 0 0 1.25rem; font-size: 1.5rem; }
  .section-head a { font-weight: 600; text-decoration: none; }
  .grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }

  .follow {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-border);
  }
  .follow h2 { margin: 0; font-size: 1.5rem; }
  .follow p { color: var(--color-ink-muted); margin: 0.5rem 0 1.25rem; }
</style>
