---
import { SITE_TITLE } from '../site';
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const links = [
  { href: `${base}episodes/`, label: 'Episodes' },
  { href: `${base}#follow`, label: 'Follow' },
];
---
<header class="site-header">
  <div class="container inner">
    <a class="brand" href={base} aria-label={`${SITE_TITLE} home`}>
      <img src={`${base}brand/logo-horizontal-white.png`} alt={SITE_TITLE} width="640" height="335" />
    </a>
    <nav aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
      <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dark mode">
        <svg class="icon-moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></g></svg>
      </button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-band);
    color: var(--color-on-band);
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.4rem;
  }
  .brand img {
    display: block;
    height: clamp(52px, 9vw, 76px);
    width: auto;
  }
  nav { display: flex; align-items: center; gap: clamp(1rem, 3vw, 2rem); }
  nav a {
    color: inherit;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    padding-block: 0.25rem;
    border-bottom: 2px solid transparent;
  }
  nav a:hover { color: var(--color-primary-bright); }
  nav a[aria-current='page'] { border-bottom-color: var(--color-primary-bright); }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--color-band-line);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .theme-toggle:hover { color: var(--color-primary-bright); border-color: currentColor; }
  /* Show the moon in light mode and the sun in dark mode */
  .icon-sun { display: none; }
  :global(:root[data-resolved-theme='dark']) .icon-sun { display: block; }
  :global(:root[data-resolved-theme='dark']) .icon-moon { display: none; }
</style>

<script>
  const button = document.getElementById('theme-toggle');
  const root = document.documentElement;
  const update = () => {
    const dark = root.dataset.resolvedTheme === 'dark';
    button?.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
  };
  update();
  button?.addEventListener('click', () => {
    const next = root.dataset.resolvedTheme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    root.dataset.resolvedTheme = next;
    try { localStorage.setItem('theme', next); } catch {}
    update();
  });
</script>
