---
import { SITE_TITLE } from '../site';
const base = import.meta.env.BASE_URL;
---
<header class="site-header">
  <div class="container inner">
    <a class="brand" href={base}>{SITE_TITLE}</a>
    <nav aria-label="Main">
      <a href={`${base}episodes/`}>Episodes</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-ink);
    color: var(--color-bg);
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
  }
  .brand {
    font-family: var(--font-display);
    font-weight: 700;
    color: inherit;
    text-decoration: none;
    font-size: 1.15rem;
  }
  nav a {
    color: inherit;
    text-decoration: none;
    font-weight: 600;
  }
  nav a:hover { color: var(--color-primary-bright); }
</style>
