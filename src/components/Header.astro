---
import { SITE_TITLE } from '../site';
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const links = [
  { href: `${base}episodes/`, label: 'Episodes' },
  { href: `${base}#follow`, label: 'Follow' },
];
---
<header class="site-header">
  <div class="container inner">
    <a class="brand" href={base} aria-label={`${SITE_TITLE} home`}>
      <img src={`${base}brand/logo-horizontal-white.png`} alt={SITE_TITLE} width="640" height="335" />
    </a>
    <nav aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-ink);
    color: var(--color-on-ink);
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.4rem;
  }
  .brand img {
    display: block;
    height: clamp(52px, 9vw, 76px);
    width: auto;
  }
  nav { display: flex; gap: clamp(1rem, 3vw, 2rem); }
  nav a {
    color: inherit;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    padding-block: 0.25rem;
    border-bottom: 2px solid transparent;
  }
  nav a:hover { color: var(--color-primary-bright); }
  nav a[aria-current='page'] { border-bottom-color: var(--color-primary-bright); }
</style>
