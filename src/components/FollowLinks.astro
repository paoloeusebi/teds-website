---
import { PLATFORMS } from '../site';
---
<ul class="follow">
  {PLATFORMS.map((p) => (
    <li><a class="button secondary" href={p.url}>{p.name}</a></li>
  ))}
</ul>

<style>
  .follow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
