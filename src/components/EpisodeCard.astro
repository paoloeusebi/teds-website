---
import type { CollectionEntry } from 'astro:content';
import { formatDate, formatDuration } from '../lib/format';

interface Props {
  episode: CollectionEntry<'episodes'>;
  headingLevel?: 'h2' | 'h3';
}
const { episode, headingLevel: Heading = 'h3' } = Astro.props;
const { number, title, pubDate, durationSeconds, summary } = episode.data;
const href = `${import.meta.env.BASE_URL}episodes/${episode.id}/`;
---
<article class="card" data-search={`${number ?? ''} ${title} ${summary}`.toLowerCase()}>
  <p class="meta">
    {number !== null && <span class="number">#{number}</span>}
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    {durationSeconds && <span>{formatDuration(durationSeconds)}</span>}
  </p>
  <Heading class="title"><a href={href}>{title}</a></Heading>
  {summary && <p class="summary">{summary}</p>}
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.25rem 1.5rem;
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }
  .card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
    font-size: 0.8rem;
    color: var(--color-ink-muted);
  }
  .number { font-weight: 600; color: var(--color-primary); }
  .title { margin: 0; font-size: 1.1rem; }
  .title a { color: var(--color-ink); text-decoration: none; }
  /* Whole card is clickable */
  .title a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .card:hover .title a { color: var(--color-primary); }
  .summary {
    margin: 0;
    font-size: 0.92rem;
    color: var(--color-ink-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
